{
  "id": "./",
  "name": "Controle de Gastos",
  "short_name": "Gastos",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E6E9EE",
  "theme_color": "#2A3547",
  "icons": [
    {
      "src": "icons/gastos.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-inbox",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      ]
    }
  }
}